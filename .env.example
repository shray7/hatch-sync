# Hatch account (used to list and control Rest devices and Grow sync)
HATCH_EMAIL=your@email.com
HATCH_PASSWORD=your_password

# Google Calendar sync (Hatch Grow → calendar)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
GOOGLE_CALENDAR_SHARE_EMAIL=your@gmail.com

# Google OAuth for admin (sign-in and device upload)
# Create OAuth 2.0 Client ID (Web application) in Google Cloud Console; set authorized redirect URI to https://<your-api-host>/auth/callback
# GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxx
# Comma-separated emails allowed to access admin and upload/import.
# ADMIN_ALLOWLIST_EMAILS=you@gmail.com
# Signing secret for session cookie (set in production; otherwise a random value is used at startup).
# SESSION_SECRET=your-secret-at-least-32-chars
# Backend base URL for OAuth redirect_uri (e.g. https://your-api.azurecontainerapps.io). Leave unset to use request base URL.
# API_BASE_URL=
# Frontend URL to redirect to after login (e.g. https://shray7.github.io).
# FRONTEND_URL=https://shray7.github.io

# Azure Blob Storage for photos and videos (private containers)
# Connection string for your storage account (keep secret; set in Azure as a secret/env var too).
# AZURE_BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=...
# Container for photos (and Hatch-synced images).
# AZURE_BLOB_CONTAINER=hatch-photos
# Container for videos (admin uploads). Defaults to hatch-videos if unset.
# AZURE_BLOB_VIDEO_CONTAINER=hatch-videos

# Timezone for Hatch API datetimes (e.g. America/Los_Angeles). If set, diaper/feeding/sleep/weight
# times from Hatch are interpreted as this zone and converted to UTC for the calendar.
# If unset, times are treated as UTC (calendar events may show wrong local time).
# HATCH_TIMEZONE=America/Los_Angeles

# Redis cache (optional)
# Local/docker-compose: redis://redis:6379/0
# Azure Phase 1: set by scripts/azure-setup.sh (internal Redis Container App).
# Azure Phase 2: use Azure Cache for Redis (e.g. rediss://<host>:6380,ssl=True,...).
REDIS_URL=redis://redis:6379/0

# TTL (in seconds) for cached Hatch Grow data and photos.
# Defaults to 900 (15 minutes) if unset.
HATCH_CACHE_TTL_SECONDS=900

# How often (minutes) to refresh the grow data cache in the background. Keeps cache warm
# so page loads are fast; new diapers/feedings etc. appear within this interval.
# Defaults to 15 if unset.
# HATCH_CACHE_REFRESH_MINUTES=15
