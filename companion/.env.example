# Companion server for Uppy Google Photos Picker
# Copy to .env and fill in values.

PORT=3020
COMPANION_DOMAIN=localhost:3020
COMPANION_PROTOCOL=http
COMPANION_SECRET=change-me-to-a-long-random-string
COMPANION_DATADIR=./output

# Allow frontend origins (comma-separated). Must include your Admin UI origin.
COMPANION_CLIENT_ORIGINS=http://localhost:5173,https://shray7.github.io

# Enable Google Photos / Drive Picker (default: true)
COMPANION_ENABLE_GOOGLE_PICKER_ENDPOINT=true

# Optional: Google Drive/Photos OAuth for server-side provider (key/secret). For Picker, clientId is set in frontend.
# COMPANION_GOOGLE_KEY=
# COMPANION_GOOGLE_SECRET=

# Where Companion is allowed to upload (your API). Comma-separated URLs.
COMPANION_UPLOAD_URLS=http://localhost:8000/admin/upload-companion

# Headers to send when Companion uploads (e.g. secret for /admin/upload-companion). JSON object.
COMPANION_UPLOAD_HEADERS={"X-Companion-Secret":"your-secret-matching-COMPANION_UPLOAD_SECRET-on-api"}
